$result = $conn->query("SELECT * FROM students");

while($row = $result->fetch_assoc()) {
echo "ID:" . $row['id'] . "<br>";
echo "Name:" .$row['name']."<br>";
echo "Email:" .$row['email']."<br>";
echo "Age:" .$row['age']."<br>";

}



